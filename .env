# servidor
SERVER_PORT=8080

# strategy de persistência: redis | memory
RATE_LIMITER_STRATEGY=redis

# redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# janela de contagem
RATE_LIMIT_WINDOW=1s

# limite por IP (vale para quem não manda API_KEY)
RATE_LIMIT_IP_MAX_REQUESTS=10
RATE_LIMIT_IP_BLOCK_DURATION=5m

# limites por token: token:req/s:bloqueio,token:req/s:bloqueio
RATE_LIMIT_TOKENS=abc123:100:5m,premium456:1000:1m,fraco789:2:30s
